<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Packing Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/Views/Packing/packing.css">
    <%- include('../Template/navbar') %>
</head>

<body>
    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-box-open"></i> ระบบจัดการคำสั่งซื้อ</h1>
        </div>

        <div class="table-container">
            <h2><i class="fas fa-clipboard-list"></i> รายการคำสั่งซื้อ</h2>
            <table>
                <thead>
                    <tr>
                        <th><i class="fas fa-hashtag"></i> รหัสคำสั่งซื้อ</th>
                        <th title="Customer Name"><i class="fas fa-user"></i> ลูกค้า</th>
                        <th><i class="fas fa-info-circle"></i> รายละเอียด</th>
                        <th><i class="fas fa-calendar"></i> วันที่</th>
                        <th><i class="fas fa-file-invoice"></i> รูปภาพ</th>
                        <th><i class="fas fa-tasks"></i> สถานะ</th>
                        <th><i class="fas fa-tools"></i> การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example product rows -->
                    <% orders.forEach(order=> { %>
                        <tr>
                            <td>
                                <%=order.order_id%>
                            </td>
                            <td>
                                <%=order.customer%>
                            </td>
                            <td>
                                <%=order.description%>
                            </td>
                            <td>
                                <%=order.order_date%>
                            </td>
                            <td>
                                <a href="#" class="btn-image"
                                    onclick="viewImages('/Asset/PaymentProof/<%=order.bill_img%>', '/Asset/Products/<%=order.product_img%>')">
                                    <i class="fas fa-images"></i> ดู
                                </a>
                            </td>

                            <%if (order.status==3){%>
                                <td id="status-<%=order.order_id%>" class="status-packing">กำลังแพ็ค</td>
                                <%} else if (order.status==4){%>
                                    <td id="status-<%=order.order_id%>" class="status-success">สำเร็จ</td>
                                    <%} else if (order.status==5){%>
                                        <td id="status-<%=order.order_id%>" class="status-failed">ล้มเหลว</td>
                                        <%}else if (order.status == 2){%>
                                            <td id="status-<%=order.order_id%>" class="status-waiting">รอการแพ็ค</td>
                                            <%}%>
                                                <!-- <td id="status-1" class="status-waiting">Waiting for packing</td> -->
                                                <td>
                                                    <div class="action-buttons">
                                                        <a href="#" class="btn-packing"
                                                            onclick="changeStatus('status-<%=order.order_id%>', 'Packing')">
                                                            <i class="fas fa-box"></i> กำลังแพ็ค
                                                        </a>
                                                        <a href="#" class="btn-success"
                                                            onclick="changeStatus('status-<%=order.order_id%>', 'Success')">
                                                            <i class="fas fa-check"></i> สำเร็จ
                                                        </a>
                                                        <a href="#" class="btn-failed"
                                                            onclick="changeStatus('status-<%=order.order_id%>', 'Failed')">
                                                            <i class="fas fa-times"></i> ล้มเหลว
                                                        </a>
                                                    </div>
                                                </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Image Modal -->
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="images-grid">
                <div class="image-card">
                    <h3>ใบเสร็จชำระเงิน</h3>
                    <img id="billImage" class="modal-image" alt="Payment Receipt">
                </div>
                <div class="image-card">
                    <h3>รูปสินค้า</h3>
                    <img id="productImage" class="modal-image" alt="Product Image">
                </div>
            </div>
        </div>
    </div>

    <script src="/Views/Packing/packing.js"></script>
</body>

</html>