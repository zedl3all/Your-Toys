<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Packing Management</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/Views/Packing/packing.css">
    <%- include('../Template/navbar') %>
</head>

<body>
    <div class="container">
        <div class="page-header">
            <h1><i class="fas fa-box-open"></i> Order Processing System</h1>
        </div>
        
        <div class="table-container">
            <h2><i class="fas fa-clipboard-list"></i> Order List</h2>
            <table>
                <thead>
                    <tr>
                        <th><i class="fas fa-hashtag"></i> Order ID</th>
                        <th title="Customer Name"><i class="fas fa-user"></i> Customer</th>
                        <th><i class="fas fa-info-circle"></i> Description</th>
                        <th><i class="fas fa-calendar"></i> Date</th>
                        <th><i class="fas fa-file-invoice"></i> Image(Bill)</th>
                        <th><i class="fas fa-tasks"></i> Status</th>
                        <th><i class="fas fa-tools"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Example product rows -->
                    <tr>
                        <td>Order 1</td>
                        <td>John Doe</td>
                        <td>Desktop Computer Parts</td>
                        <td>24/2/2025</td>
                        <td>
                            <a href="#" class="btn-image" onclick="viewImage('bill1.jpg')">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </td>
                        <td id="status-1" class="status-waiting">Waiting for packing</td>
                        <td>
                            <div class="action-buttons">
                                <a href="#" class="btn-packing" onclick="changeStatus('status-1', 'Packing')">
                                    <i class="fas fa-box"></i> Packing
                                </a>
                                <a href="#" class="btn-success" onclick="changeStatus('status-1', 'Success')">
                                    <i class="fas fa-check"></i> Success
                                </a>
                                <a href="#" class="btn-failed" onclick="changeStatus('status-1', 'Failed')">
                                    <i class="fas fa-times"></i> Failed
                                </a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Image Modal -->
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <img id="billImage" src="" alt="Bill Image">
        </div>
    </div>
    
    <script src="/Views/Packing/packing.js"></script>
</body>

</html>