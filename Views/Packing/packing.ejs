<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Packing Page</title>
    <link rel="stylesheet" href="/Views/Packing/packing.css">
</head>

<body>
    <div class="container">
        <h2>Order List</h2>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th title="Customer Name">Customer Name</th>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Example product rows -->
                <tr>
                    <td>Order 1</td>
                    <td>John Doe</td>
                    <td>-----</td>
                    <td>24/2/2025</td>
                    <td id="status-1">Waiting for packing</td>
                    <td>
                        <a href="#" onclick="changeStatus('status-1', 'Packing')">Packing</a>
                        <a href="#" onclick="changeStatus('status-1', 'Success')">Success</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <script src="/Views/Packing/packing.js"></script>
</body>

</html>