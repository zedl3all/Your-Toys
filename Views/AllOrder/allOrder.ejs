<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Orders</title>
    <link rel="stylesheet" href="/Views/AllOrder/allOrder.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <%- include("../Template/navbar.ejs") %>
</head>

<body>
    <div class="container">
        <h2>รายการสั่งซื้อ</h2>
        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message">
                <p><%= message %></p>
                <% if (message === "Please log in to view your orders") { %>
                    <a href="/login" class="login-button">Login</a>
                <% } %>
            </div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th><i class="fas fa-hashtag"></i> รหัสสั่งซื้อ</th>
                        <th><i class="fas fa-box"></i> สินค้า</th>
                        <th><i class="fas fa-info-circle"></i> รายละเอียด</th>
                        <th><i class="far fa-calendar-alt"></i> วันที่</th>
                        <th><i class="fas fa-flag"></i> สถานะ</th>
                        <th><i class="fas fa-money-bill-wave"></i> ราคารวม</th>
                        <th id="cen"><i class="fas fa-image"></i> รูปภาพ</th>
                        <th id="cen"><i class="fas fa-cog"></i> การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (orders && orders.length > 0) { %>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td><%= order.order_id %></td>
                                <td>
                                    <% let productNames = order.items.map(item => item.name).join(', '); %>
                                    <%= productNames %>
                                </td>
                                <td>
                                    <% if (order.items && order.items.length > 0) { %>
                                        <% order.items.forEach((item, index) => { %>
                                            <div>
                                                <%= item.detail || 'No specifications' %>
                                                <% if (index < order.items.length - 1) { %><hr><% } %>
                                            </div>
                                        <% }); %>
                                    <% } else { %>
                                        No details available
                                    <% } %>
                                </td>
                                <td><%= order.order_date %></td>
                                <td id="status-<%= order.status_id %>">
                                    <%= statusLabels[order.status_id] %>
                                </td>
                                <td>
                                    ฿<%= order.total.toFixed(2) %>
                                </td>
                                <td>
                                    <a href="#" class="btn-image"
                                        onclick="viewImages('/Asset/PaymentProof/<%=order.bill_img%>', '/Asset/Products/<%=order.product_img%>')">
                                        <i class="fas fa-images"></i> ดู
                                    </a>
                                </td>
                                <td>
                                    <a class="detail" href="/tracking/<%= order.order_id %>">รายละเอียด</a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="no-orders">คุณยังไม่มีคำสั่งซื้อ</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        <% } %>
    </div>
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="images-grid">
                <div class="image-card">
                    <h3>ใบเสร็จชำระเงิน</h3>
                    <img id="billImage" class="modal-image" alt="Payment Receipt">
                </div>
                <div class="image-card">
                    <h3>รูปสินค้า</h3>
                    <img id="productImage" class="modal-image" alt="Product Image">
                </div>
            </div>
        </div>
    </div>
    <script src="/Views/AllOrder/allOrder.js"></script>
</body>

</html>