<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Slick Carousel -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" type="text/css"
        href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />
    <script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    <!-- Css -->
    <link rel="stylesheet" href="/Views/Home/home.css">
    <title>YourToy Shop</title>
    <%- include("../Template/navbar.ejs") %>
</head>

<body>
    <!-- Slider main container for ads -->
    <div class="container-ad">
        <div class="ad1">
            <div class="slide-ads">
                <div class="ad-item"
                    style="background-image: url('/Asset/Ads/ads1.jpg'); background-position: center;"></div>
                <div class="ad-item" style="background-image: url('/Asset/Ads/ads2.jpg');"></div>
                <div class="ad-item" style="background-image: url('/Asset/Ads/ads3.jpg');"></div>
            </div>
        </div>
    </div>
    <% categories.forEach((catbox)=>{ %>
        <div class="container my-4">
            <h1 class="title-with-link d-flex justify-content-between align-items-center">
                <span><%=catbox.name%></span>
                <a href='/ProductAll/<%=catbox.id%>' class="view-all-link fs-6 text-decoration-none">ดูทั้งหมด &gt;</a>
            </h1>
            <div class="cat">
                <div class="product-slide">
                    <% products.forEach((item)=>{ %>
                        <% if(item.c_id==catbox.id){ %>
                            <div class="item" onclick="window.location.href='/Product/<%=item.id%>'">
                                <div class="item-top">
                                    <% if(item.image==null){ %>
                                        <img src="/Asset/Product/dummy.jpg" alt="figure1" class="img-fluid">
                                    <% }; %>
                                    <% if(item.image !=null){ %>
                                        <img src="/Asset/Product/<%=item.image%>" alt="figure1" class="img-fluid">
                                    <% }; %>
                                </div>
                                <div class="item-bottom">
                                    <h5 class="p-name">
                                        <%=item.name%>
                                    </h5>
                                    <p class="p-small-text">
                                        <%=item.description%>
                                    </p>
                                    <p class="p-price">
                                        <%=item.price%>฿
                                    </p>
                                </div>
                            </div>
                        <% }; %>
                    <% }); %>
                </div>
            </div>
        </div>
    <% }); %>

    <!-- Import Js -->
    <script src="/Views/Home/home.js"></script>
</body>

</html>