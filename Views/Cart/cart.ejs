<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Views/Cart/cart.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
    <%- include('../Template/navbar') %>
</head>

<body>
    <div class="cart-container">
        <h2>Cart</h2>
        <div class="cart">
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Price</th>
                        <th id="qua">Quantity</th>
                        <th>Total</th>
                        <th id="qua">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    <% for (let i = 0; i < cart.length; i++) { %>
                        <tr>
                            <td><img src="Asset/Logo.svg" alt="Product Image" style="width: 50px; height: 50px;"></td>
                            <td><%= cart[i].name %></td>
                            <td><%= cart[i].price %></td>
                            <td class="quantity" id="qua">
                                <a href="/cart/remove/<%= cart[i].id %>" class="btnt">-</a>
                                <%= cart[i].quantity %>
                                <a href="/cart/add/<%= cart[i].id %>" class="btnt">+</a>
                            </td>
                            <td><%= cart[i].price * cart[i].quantity %></td>
                            <td style="width: 8%;"><a href="/detail/<%= cart[i].id %>" class="btnt">Detail</a></td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="total">
            <h2>Total: <%= total %></h2>
        </div>
        <div class="actions">
            <a href="/">Continue Shopping</a>
            <a href="/checkout" >Checkout</a>
        </div>
    </div>
    <script src="/Views/Cart/cart.js"></script>
</body>

</html>