<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Views/Cart/cart.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <%- include('../Template/navbar') %>
</head>

<body>
    <!-- Cart Container -->
    <div class="cart-container">
        <h2>รถเข็น</h2>
        <div class="cart">
            <table>
                <thead>
                    <tr>
                        <th><i class="fas fa-image me-2"></i>รูปภาพ</th>
                        <th><i class="fas fa-box me-2"></i>สินค้า</th>
                        <th><i class="fas fa-tag me-2"></i>ราคาพื้นฐาน</th>
                        <th><i class="fas fa-expand me-2"></i>อัตราส่วน</th>
                        <th id="qua"><i class="fas fa-cubes me-2"></i>ปริมาณ</th>
                        <th><i class="fas fa-tags me-2"></i>ราคาต่อชิ้น</th>
                        <th><i class="fas fa-calculator me-2"></i>ราคารวม</th>
                        <th id="qua"><i class="fas fa-cog me-2"></i>การจัดการ</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof cart !=='undefined' && cart.length> 0) { %>
                        <% for (let i=0; i < cart.length; i++) { %>
                            <tr>
                                <td>
                                    <img src="/Asset/Product/<%= cart[i].image || 'dummy.jpg' %>"
                                        alt="<%= cart[i].name %>" style="width: 50px; height: 50px;">
                                </td>
                                <td>
                                    <%= cart[i].name %>
                                </td>
                                <td>฿<%= cart[i].price.toFixed(2) %>
                                </td>
                                <td>
                                    <%= cart[i].size || '1:1' %>
                                </td>
                                <td class="quantity" id="qua">
                                    <a href="/cart/remove/<%= cart[i].order_id %>?userId=<%= userId %>"
                                        class="btnt"><i class="fas fa-minus"></i></a>
                                    <%= cart[i].quantity %>
                                        <a href="/cart/add/<%= cart[i].product_id %>?userId=<%= userId %>&ratio=<%= encodeURIComponent(cart[i].size) %>&specify=<%= encodeURIComponent(cart[i].detail || '') %>"
                                            class="btnt"><i class="fas fa-plus"></i></a>
                                </td>
                                <td>
                                    <%= cart[i].priceWithRatio.toFixed(2) %>฿
                                </td>
                                <td>
                                    <%= cart[i].itemTotal.toFixed(2) %>฿
                                </td>
                                <td style="width: 8%; text-align: center;">
                                    <button type="button" class="btnt" onclick="showDetailModal(this)" data-product='<%= JSON.stringify({
                                            name: cart[i].name,
                                            image: cart[i].image,
                                            img: cart[i].img,
                                            price: cart[i].price,
                                            size: cart[i].size,
                                            quantity: cart[i].quantity,
                                            detail: cart[i].detail
                                        }) %>'>
                                        <i class="fas fa-info-circle me-2"></i>รายละเอียด
                                    </button>
                                </td>
                            </tr>
                            <% } %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <%= typeof message !=='undefined' && message ? message
                                                : "รถเข็นของคุณว่างเปล่า" %>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <!-- Cart Total and Actions -->
        <div class="total">
            <p style="display: none;" id="total-value">
                <%= total.toFixed(2) %>
            </p>
            <h2>Total: <%= total.toFixed(2) %>฿</h2>
        </div>
        <div class="actions">
            <a href="/ProductAll"><i class="fa-solid fa-cart-plus"></i> ดำเนินการเลือกซื้อต่อไป</a>
            <a onclick="generateQR()"><i class="fa-solid fa-credit-card"></i> ชำระเงิน</a>
        </div>
    </div>

    <!-- Product Detail Modal -->
    <div id="productDetailModal" class="modal">
        <div class="modal-content">
            <button class="close" onclick="closeProductDetailModal()">&times;</button>
            <h2>รายละเอียดสินค้า</h2>

            <div class="payment-flex-container">
                <!-- Left side - Product image -->
                <div class="payment-left-section">
                    <div class="product-image-container">
                        <img id="modalProductImage" src="" alt=""
                            style="width: 100%; border-radius: 8px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    </div>
                </div>

                <!-- Right side - Product information -->
                <div class="payment-right-section">
                    <h3 id="modalProductName" class="product-title"></h3>

                    <div class="product-info-box">
                        <h4>รายละเอียด</h4>
                        <p id="modalProductDetail" class="product-description"></p>
                    </div>

                    <div class="product-info-grid">
                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-tag me-2"></i>ราคา:</span>
                            <span class="info-value">฿<span id="modalProductPrice"></span></span>
                        </div>

                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-expand me-2"></i>อัตราส่วน:</span>
                            <span class="info-value" id="modalProductSize"></span>
                        </div>

                        <div class="info-item">
                            <span class="info-label"><i class="fas fa-cubes me-2"></i>ปริมาณ:</span>
                            <span class="info-value" id="modalProductQuantity"></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- <div class="modal-footer">
                <button type="button" class="btn-secondary" onclick="closeProductDetailModal()">Close</button>
            </div> -->
        </div>
    </div>

    <!-- QR Payment Modal -->
    <div id="qrModal" class="modal">
        <div class="modal-content">
            <button class="close" onclick="closeQRModal()"><i class="fas fa-times"></i></button>
            <h2><i class="fas fa-qrcode me-2"></i>ชำระเงินผ่าน PromptPay QR</h2>

            <div class="payment-flex-container">
                <!-- Left side - QR code -->
                <div class="payment-left-section">
                    <div id="qrContainer" class="qr-container">
                        <!-- QR code will be inserted here -->
                        <div class="loading">Generating QR code...</div>
                    </div>

                    <div class="qr-info">
                        <p>สแกนรหัส QR นี้ด้วยแอพธนาคารใด ๆ ที่รองรับ PromptPay</p>
                        <p class="promptpay-id" id="promptpayDisplay"></p>
                        <div class="amount-display" id="amountDisplay"></div>
                    </div>
                </div>

                <!-- Right side - Upload section -->
                <div id="uploadSection" class="payment-right-section" style="display: none;">
                    <h3>ชำระเงินเสร็จสิ้น?</h3>
                    <p>โปรดอัปโหลดภาพหน้าจอของการยืนยันการชำระเงินของคุณ</p>

                    <div id="previewContainer" class="preview-container" style="display: none;">
                        <img id="imagePreview" src="#" alt="Payment Proof Preview">
                    </div>

                    <div class="file-input-wrapper">
                        <input type="file" id="paymentProof" accept="image/*" class="file-input">
                        <label for="paymentProof" class="file-label"><i class="fas fa-upload me-2"></i>เลือกภาพหน้าจอ</label>
                    </div>

                    <button id="uploadBtn" class="upload-btn" disabled><i class="fas fa-cloud-upload-alt me-2"></i>อัปโหลดหลักฐานการชำระเงิน</button>
                    <div id="uploadStatus" class="upload-status"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="/Views/Cart/cart.js"></script>
</body>

</html>