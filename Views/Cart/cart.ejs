<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="/Views/Cart/cart.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/js/bootstrap.bundle.min.js"></script>
    <%- include('../Template/navbar') %>
</head>

<body>
    <div class="cart-container">
        <h2>Cart</h2>
        <div class="cart">
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Base Price</th>
                        <th>Size</th>
                        <th id="qua">Quantity</th>
                        <th>Unit Price</th>
                        <th>Total</th>
                        <th id="qua">Detail</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof cart !=='undefined' && cart.length> 0) { %>
                        <% for (let i=0; i < cart.length; i++) { %>
                            <tr>
                                <td><img src="/Asset/Product/<%= cart[i].image || 'dummy.jpg' %>"
                                        alt="<%= cart[i].name %>" style="width: 50px; height: 50px;"></td>
                                <td>
                                    <%= cart[i].name %>
                                        <% if (cart[i].detail && cart[i].detail.length> 0) { %>
                                            <div class="note"><small>
                                                    <%= cart[i].detail %>
                                                </small></div>
                                            <% } %>
                                </td>
                                <td>฿<%= cart[i].price.toFixed(2) %>
                                </td>
                                <td>
                                    <%= cart[i].size || '1:1' %>
                                </td>
                                <td class="quantity" id="qua">
                                    <a href="/cart/remove/<%= cart[i].order_id %>?userId=<%= userId %>"
                                        class="btnt">-</a>
                                    <%= cart[i].quantity %>
                                        <a href="/cart/add/<%= cart[i].product_id %>?userId=<%= userId %>&ratio=<%= encodeURIComponent(cart[i].size) %>&specify=<%= encodeURIComponent(cart[i].detail || '') %>"
                                            class="btnt">+</a>
                                </td>
                                <td><%= cart[i].priceWithRatio.toFixed(2) %>฿
                                </td>
                                <td><%= cart[i].itemTotal.toFixed(2) %>฿
                                </td>
                                <td style="width: 8%;">
                                    <button type="button" class="btnt" data-bs-toggle="modal" data-bs-target="#productDetailModal" data-product='<%= JSON.stringify(cart[i]) %>'>Detail</button>
                                </td>
                            </tr>
                            <% } %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <%= typeof message !=='undefined' && message ? message
                                                : "Your cart is empty" %>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
        <div class="total">
            <h2>Total: <%= total.toFixed(2) %>฿
            </h2>
        </div>
        <div class="actions">
            <a href="/">Continue Shopping</a>
            <a href="/checkout">Checkout</a>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="productDetailModalLabel">Product Detail</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <img id="modalProductImage" src="" alt="" style="width: 100%;">
                    <h5 id="modalProductName"></h5>
                    <p id="modalProductDetail"></p>
                    <p>Price: ฿<span id="modalProductPrice"></span></p>
                    <p>Size: <span id="modalProductSize"></span></p>
                    <p>Quantity: <span id="modalProductQuantity"></span></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="/Views/Cart/cart.js"></script>
</body>

</html>