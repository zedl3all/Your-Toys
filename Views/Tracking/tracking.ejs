<!DOCTYPE html>
<html>

<head>
    <title>Parcel Sandbox</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script defer src="Views/Tracking/tracking.js"></script>
    <link rel="stylesheet" href="/Views/Tracking/tracking.css" />
    <title>Steps/Progress Bar with Vanilla JS</title>
    <%- include("../Template/navbar.ejs") %>
</head>

<body>
    <main class="container">
        <div class="progress__container">
            <div class="progress__bar js-bar"></div>
            <div class="progress__circle js-circle active">
                <img src="/Asset/Tracking/order.png" alt="Step 1" class="progress__img">
            </div>
            <div class="progress__circle js-circle">
                <img src="/Asset/Tracking/packed.png" alt="Step 2" class="progress__img">
            </div>
            <div class="progress__circle js-circle">
                <img src="/Asset/Tracking/complete.png" alt="Step 3" class="progress__img">
            </div>
        </div>

        <!-- <div class="wrapper">
            <button type="button" class="btn js-prev" disabled>Previous</button>
            <button type="button" class="btn js-next">Next</button>
        </div> -->

        <div class="order-details">
            <h2>Order Details</h2>
            <p><strong>Order Number:</strong> 123456</p>
            <p><strong>Customer Name:</strong> John Doe</p>
            <p><strong>Shipping Address:</strong> 1234 Elm Street, Springfield, IL 62704</p>
            <p><strong>Order Date:</strong> February 25, 2025</p>
            <p><strong>Estimated Delivery:</strong> March 1, 2025</p>
        </div>
        <div class="buttons">
            <button onclick="window.history.back()">Back</button>
        </div>
    </main>
</body>

</html>