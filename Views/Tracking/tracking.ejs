<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/Views/Tracking/tracking.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <title>Order Tracking</title>
    <%- include("../Template/navbar.ejs") %>
</head>

<body>
    <main class="container">
        <% if (typeof order==='undefined' || !order) { %>
            <div class="message">
                <p>
                    <%= typeof message !=='undefined' ? message : "ไม่พบคำสั่งซื้อ" %>
                </p>
                <div class="buttons">
                    <button onclick="window.history.back()">ย้อนกลับ</button>
                </div>
            </div>
        <% } else { %>
            <h1 class="tracking-title">ติดตามคำสั่งซื้อ</h1>
            
            <div class="progress__container <%= order.status_id >= 5 ? 'failed' : '' %>" data-status-id="<%= order.status_id %>">
                <div class="progress__bar js-bar"></div>
                
                <div class="progress__step">
                    <div class="progress__circle js-circle <%= order.status_id >= 2 ? 'active' : '' %>">
                        <i class="fas fa-box-open"></i>
                    </div>
                    <div class="progress__label">รอการแพ็คสินค้า</div>
                </div>
                
                <div class="progress__step">
                    <div class="progress__circle js-circle <%= order.status_id >= 3 ? 'active' : '' %>">
                        <i class="fas fa-box"></i>
                    </div>
                    <div class="progress__label">กำลังแพ็คสินค้า</div>
                </div>
                
                <div class="progress__step">
                    <div class="progress__circle js-circle <%= order.status_id >= 4 ? 'active' : '' %>">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="progress__label">สำเร็จ</div>
                </div>
            </div>

            <div class="order-details">
                <h2>รายละเอียดคำสั่งซื้อ</h2>
                <p><strong>หมายเลขคำสั่งซื้อ:</strong> <%= order.order_id %></p>
                <p><strong>ชื่อลูกค้า:</strong> <%= order.customer_name %></p>
                <p><strong>ช่องทางติดต่อ:</strong> <%= order.email || 'ไม่ระบุ' %> | <%= order.phone || 'ไม่ระบุ' %></p>
                <p><strong>ที่อยู่จัดส่ง:</strong> <%= order.address || 'ไม่ได้ระบุ' %></p>
                <p><strong>วันที่สั่งซื้อ:</strong> <%= order.order_date %></p>
            </div>
            <div class="buttons">
                <button onclick="window.history.back()">ย้อนกลับ</button>
            </div>
        <% } %>
    </main>

    <script src="/Views/Tracking/tracking.js"></script>
</body>

</html>