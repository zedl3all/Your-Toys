<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Progress Stepper</title>
    <link rel="stylesheet" href="/Views/Tracking/tracking.css">
    <%- include("../Template/navbar.ejs") %>
</head>

<body>
    <div class="container">
        <div class="stepper">
            <div class="progress-line">
                <div class="progress-bar"></div>
            </div>
            <div class="step-container">
                <div class="step active"><img src="/Asset/Tracking/order.png" alt="Step 1"></div>
                <span class="step-label">Order</span>
            </div>
            <div class="step-container">
                <div class="step"><img src="/Asset/Tracking/packed.png" alt="Step 2"></div>
                <span class="step-label">Packing</span>
            </div>
            <div class="step-container">
                <div class="step"><img src="/Asset/Tracking/complete.png" alt="Step 3"></div>
                <span class="step-label">Completed</span>
            </div>
        </div>
        <!-- <div class="buttons">
            <button id="prevBtn" disabled>Previous</button>
            <button id="nextBtn">Next</button>
        </div> -->
        <!-- Order Details Section -->
        <div class="order-details">
            <h2>Order Details</h2>
            <p><strong>Order Number:</strong> 123456</p>
            <p><strong>Customer Name:</strong> John Doe</p>
            <p><strong>Shipping Address:</strong> 1234 Elm Street, Springfield, IL 62704</p>
            <p><strong>Order Date:</strong> February 25, 2025</p>
            <p><strong>Estimated Delivery:</strong> March 1, 2025</p>
        </div>
    </div>

    <script src="/Views/Tracking/tracking.js"></script>
</body>

</html>