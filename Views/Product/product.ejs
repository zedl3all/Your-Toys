<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/Views/product/product.css">
    <%- include("../Template/navbar.ejs") %>
</head>

<body class="bg-light">
    <main class="py-5">
        <div class="container">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none"><i class="bi bi-house-door"></i> Home</a></li>
                <li class="breadcrumb-item"><a href="/ProductAll" class="text-decoration-none">ProductAll</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= data.name %></li>
            </ol>

            <div class="row g-4">
                <!-- Product Gallery -->
                <div class="col-lg-5 mb-4 mb-lg-0">
                    <div class="card border-0 shadow-sm product-card">
                        <div class="card-body p-0 position-relative">
                            <div class="product-badge"><i class="bi bi-award"></i> โดดเด่น</div>
                            <img src="/Asset/Product/<%=data.image%>" class="img-fluid rounded product-image"
                                alt="<%= data.name %>">
                        </div>
                        <div class="card-footer bg-white border-0 p-4">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-success px-3 py-2"><i class="bi bi-check2-circle me-1"></i> Available</span>
                                <div class="small text-muted" id="productId"><i class="bi bi-box-seam me-1"></i> Product ID: <%= data.id %></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product Details -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3">
                            <h2 class="card-title fw-bold mb-1">
                                <%= data.name %>
                            </h2>
                            <p class="text-muted mb-0"><i class="bi bi-palette me-1"></i> Personalize it just the way you like.</p>
                        </div>
                        <div class="card-body p-4">
                            <!-- Description Field -->
                            <div class="mb-4">
                                <h5 class="form-label fw-medium"><i class="bi bi-info-square me-1"></i> Description:</h5>
                                <div class="card border-0 bg-light">
                                    <div class="card-body">
                                        <p class="mb-0">
                                            <%= data.description %>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <!-- Specify detail Field -->
                            <div class="mb-4">
                                <label for="specify" class="form-label fw-medium"><i class="bi bi-pencil-square me-1"></i> Specify:</label>
                                <textarea id="specify" name="specify" rows="3" class="form-control"
                                    placeholder="Enter product specifications or special requests"></textarea>
                            </div>

                            <!-- Aspect Ratio Field -->
                            <div class="mb-4">
                                <label for="number_x" class="form-label fw-medium"><i class="bi bi-aspect-ratio me-1"></i> Aspect Ratio:</label>
                                <div class="d-flex align-items-center">
                                    <div class="input-group" style="max-width: 200px;">
                                        <input type="number" id="number_x" name="number_x" min="1" value="1"
                                            class="form-control text-center" data-aspect-ratio="<%= data.size %>">
                                        <span class="input-group-text bg-white fw-bold">:</span>
                                        <input type="number" id="number_y" name="number_y" min="1" value="1"
                                            class="form-control text-center">
                                    </div>
                                    <div class="ms-3 text-muted small">
                                        <i class="bi bi-info-circle"></i> Original ratio <%= data.size %>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label for="quantity" class="form-label fw-medium"><i class="bi bi-123 me-1"></i> Amount:</label>
                                <div class="d-flex align-items-center">
                                    <div class="input-group" style="max-width: 200px;">
                                        <button type="button" class="btn btn-outline-secondary" id="decreaseQuantity">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <input type="number" id="quantity" name="quantity" value="1" min="1"
                                            max="<%= data.amount %>" class="form-control text-center">
                                        <button type="button" class="btn btn-outline-secondary" id="increaseQuantity">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </div>
                                    <div class="ms-3 text-muted small">
                                        <i class="bi bi-box-seam"></i> Available: <%= data.amount %> items
                                    </div>
                                </div>
                            </div>

                            <!-- Image Upload Field -->
                            <div class="mb-4">
                                <label for="artwork" class="form-label fw-medium"><i class="bi bi-file-earmark-image me-1"></i> Upload Artwork:</label>
                                <div class="upload-zone">
                                    <input type="file" id="artwork" name="image" accept="image/*" class="form-control">
                                    <div class="form-text"><i class="bi bi-info-circle me-1"></i> Supported formats: JPG and PNG. Max 25MB.</div>
                                </div>
                                <div id="upload-preview" class="mt-2 d-none">
                                    <img id="artwork-preview" class="img-thumbnail" style="max-height: 150px;" alt="Artwork preview">
                                    <button type="button" class="btn btn-sm btn-outline-danger mt-1" id="remove-artwork">
                                        <i class="bi bi-trash me-1"></i> Remove
                                    </button>
                                </div>
                                <input type="hidden" id="uploaded-artwork-path" name="artworkPath" value="">
                            </div>

                            <!-- Hidden base price -->
                            <input type="hidden" id="basePrice" value="<%= data.price %>">

                            <!-- Price Container -->
                            <div class="card bg-light border-0 mb-4 price-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted"><i class="bi bi-tag me-1"></i> Base Price:</span>
                                        <span class="fw-medium">
                                            <%= data.price %>฿
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fs-5 fw-bold"><i class="bi bi-cash-coin me-1"></i> Total Price:</span>
                                        <span class="fs-4 fw-bold text-success" id="totalPrice">
                                            <%= data.price %>฿
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <!-- Add to Cart Button -->
                            <button
                                class="btn btn-lg w-100 d-flex align-items-center justify-content-center add-to-cart-btn"
                                id="yellowbtn" onclick="addToCart('<%= data.id %>')">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                    class="bi bi-cart-plus me-2" viewBox="0 0 16 16">
                                    <path
                                        d="M9 5.5a.5.5 0 0 0-1 0V7H6.5a.5.5 0 0 0 0 1H8v1.5a.5.5 0 0 0 1 0V8h1.5a.5.5 0 0 0 0-1H9z" />
                                    <path
                                        d="M.5 1a.5.5 0 0 0 0 1h1.11l.401 1.607 1.498 7.985A.5.5 0 0 0 4 12h1a2 2 0 1 0 0 4 2 2 0 0 0 0-4h7a2 2 0 1 0 0 4 2 2 0 0 0 0-4h1a.5.5 0 0 0 .491-.408l1.5-8A.5.5 0 0 0 14.5 3H2.89l-.405-1.621A.5.5 0 0 0 2 1zm3.915 10L3.102 4h10.796l-1.313 7zM6 14a1 1 0 1 1-2 0 1 1 0 0 1 2 0m7 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                                </svg>
                                Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Reviews Section -->
            <div class="row mt-5">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                            <h3 class="card-title fw-bold mb-0">
                                <i class="bi bi-star-fill text-warning me-2"></i>Customer Reviews
                            </h3>
                            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#reviewModal">
                                <i class="bi bi-pencil-square me-1"></i> Write a Review
                            </button>
                        </div>
                        <div class="card-body">
                            <!-- Summary Rating -->
                            <div class="row mb-4">
                                <div class="col-md-4 text-center border-end">
                                    <h1 class="display-3 fw-bold mb-0"><%=average%></h1>
                                    <p class="text-muted mb-0">Based on <%=reviews.length%> reviews</p>
                                </div>
                                <div class="col-md-8">
                                    <div class="d-flex align-items-center mb-1">
                                        <div class="text-muted me-3" style="width: 60px">5 stars</div>
                                        <div class="progress flex-grow-1" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" id="5star"></div>
                                        </div>
                                        <div class="text-muted ms-3" style="width: 40px" id="5text"><%=allscore.five%>%</div>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <div class="text-muted me-3" style="width: 60px">4 stars</div>
                                        <div class="progress flex-grow-1" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" id="4star"></div>
                                        </div>
                                        <div class="text-muted ms-3" style="width: 40px" id="4text"><%=allscore.four%>%</div>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <div class="text-muted me-3" style="width: 60px">3 stars</div>
                                        <div class="progress flex-grow-1" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" id="3star"></div>
                                        </div>
                                        <div class="text-muted ms-3" style="width: 40px" id="3text"><%=allscore.three%>%</div>
                                    </div>
                                    <div class="d-flex align-items-center mb-1">
                                        <div class="text-muted me-3" style="width: 60px">2 stars</div>
                                        <div class="progress flex-grow-1" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" id="2star"></div>
                                        </div>
                                        <div class="text-muted ms-3" style="width: 40px" id="2text"><%=allscore.two%>%</div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="text-muted me-3" style="width: 60px">1 star</div>
                                        <div class="progress flex-grow-1" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" id="1star"></div>
                                        </div>
                                        <div class="text-muted ms-3" style="width: 40px" id="1text"><%=allscore.one%>%</div>
                                    </div>
                                    <div class="d-flex align-items-center">
                                        <div class="text-muted me-3" style="width: 60px">0 star</div>
                                        <div class="progress flex-grow-1" style="height: 10px;">
                                            <div class="progress-bar bg-warning" role="progressbar" id="0star"></div>
                                        </div>
                                        <div class="text-muted ms-3" style="width: 40px" id="0text"><%=allscore.zero%>%</div>
                                    </div>
                                </div>
                            </div>
                            <script>
                                document.getElementById("5star").style.width = document.getElementById("5text").innerText;
                                document.getElementById("4star").style.width = document.getElementById("4text").innerText;
                                document.getElementById("3star").style.width = document.getElementById("3text").innerText;
                                document.getElementById("2star").style.width = document.getElementById("2text").innerText;
                                document.getElementById("1star").style.width = document.getElementById("1text").innerText;
                                document.getElementById("0star").style.width = document.getElementById("0text").innerText;
                            </script>
                            <!-- Individual Reviews -->
                            <div class="reviews-container">
                                <%reviews.forEach((review) =>{%>
                                    <div class="review-item pb-4 mb-4 border-bottom">
                                    <div class="d-flex align-items-center mb-2">
                                        <div class="avatar me-3">
                                            <img src="https://ui-avatars.com/api/?name=<%=review.username%>&background=random" class="rounded-circle" width="48" alt="John D">
                                        </div>
                                        <div>
                                            <h5 class="mb-0"><%=review.username%></h5>
                                            <div class="text-muted small">Posted on <%=review.rdate%></div>
                                        </div>
                                        <div class="stars ms-auto">
                                            <%for (let i=0; i < review.score; i++){%>
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <%}%>
                                            <%for (let i=0; i < (5-review.score); i++){%>
                                                <i class="bi bi-star text-warning"></i>
                                                <%}%>
                                        </div>
                                    </div>
                                    <h6 class="review-title fw-bold"><%=review.title%></h6>
                                    <p class="review-text"><%=review.description%></p>
                                </div>
                                <%});%>
                                
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Review Modal -->
    <div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reviewModalLabel">Write a Review</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="reviewForm">
                        <div class="mb-3">
                            <label class="form-label">Rating</label>
                            <div class="star-rating">
                                <i class="bi bi-star star-item fs-3" data-value="1"></i>
                                <i class="bi bi-star star-item fs-3" data-value="2"></i>
                                <i class="bi bi-star star-item fs-3" data-value="3"></i>
                                <i class="bi bi-star star-item fs-3" data-value="4"></i>
                                <i class="bi bi-star star-item fs-3" data-value="5"></i>
                            </div>
                            <input type="hidden" id="ratingValue" name="rating" value="0">
                        </div>
                        <div class="mb-3">
                            <label for="reviewTitle" class="form-label">Review Title</label>
                            <input type="text" class="form-control" id="reviewTitle" name="title" required>
                        </div>
                        <div class="mb-3">
                            <label for="reviewContent" class="form-label">Review</label>
                            <textarea class="form-control" id="reviewContent" name="content" rows="4" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitReview">Submit Review</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom product script -->
    <script src="/Utils/priceCalculator.js"></script>
    <script src="/Views/Product/product.js"></script>
    <script src="/Views/Product/reviews.js"></script>
</body>

</html>