<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Product</title>
    <!-- Update to Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/Views/manageProduct/manageProduct.css">
    <script src="/Views/ManageProduct/manageProduct.js"></script>
    <script src="/Views/manageProductews/manageProduct/manageProduct.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="product-container">
        <h2>Manage Product</h2>
        <div class="add-product-link">
            <div class="mb-3" id="cat-button">
                <button class="btn btn-warning px-4 py-2 fs-5 custom-button" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#sidebar" aria-controls="sidebar">
                    <i class="fas fa-bars"></i> Filter
                </button>
            </div>
            <a href="#" onclick="openAddModal()" class="custom-button">Add Product</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Product Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Ratio</th>
                    <th>Current Amount</th>
                    <th>Image</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Example product rows -->
                <% data.forEach((item)=>{ %>
                    <tr>
                        <td>
                            <%= item.name %>
                        </td>
                        <td>
                            <%= item.description %>
                        </td>
                        <td>
                            <%= item.price %>
                        </td>
                        <td>
                            <%= item.size %>
                        </td>
                        <td>
                            <%= item.amount %>
                        </td>
                        <td><img src="/Asset/Product/<%=item.image%>" alt="Product ID:<%= item.id %>" width="50"></td>
                        <td>
                            <% if (item.categories && item.categories.length> 0) { %>
                                <% item.categories.forEach((cat, index)=> { %>
                                    <%= cat.name %>
                                        <%= index < item.categories.length-1 ? ', ' : '' %>
                                            <% }); %>
                                                <% } else { %>
                                                    <span class="no-category">No categories</span>
                                                    <% } %>
                        </td>
                        <td>
                            <a href="#" class="edit-link"
                                onclick="event.preventDefault(); openEditModal('<%= item.id %>')">Edit</a><a href="#"
                                class="remove-link"
                                onclick="event.preventDefault(); removeProduct('<%= item.id %>')">Remove</a>
                        </td>
                    </tr>
                    <% }); %>
                        <!-- <tr>
                    <td>Product 1</td>
                    <td>Sample description for product 1</td>
                    <td>$10.00</td>
                    <td>Medium</td>
                    <td>
                        <div class="amount-controls">
                            <button onclick="updateAmount(1, -1)">-</button>
                            <input type="number" id="amount-1" value="50" onchange="updateAmountDirectly(1)">
                            <button onclick="updateAmount(1, 1)">+</button>
                        </div>
                    </td>
                    <td><img src="/path/to/image1.jpg" alt="Product 1" width="50"></td>
                    <td>
                        <a href="#" class="edit-link" onclick="openEditModal(1)">Edit</a><a href="#" class="remove-link" onclick="removeProduct(1)">Remove</a>
                    </td>
                    
                </tr> -->
                        <!-- <tr>
                    <td>Product 2</td>
                    <td>Sample description for product 2</td>
                    <td>$20.00</td>
                    <td>Large</td>
                    <td>
                        <div class="amount-controls">
                            <button onclick="updateAmount(2, -1)">-</button>
                            <input type="number" id="amount-2" value="30" onchange="updateAmountDirectly(2)">
                            <button onclick="updateAmount(2, 1)">+</button>
                        </div>
                    </td>
                    <td><img src="/path/to/image2.jpg" alt="Product 2" width="50"></td>
                    <td>
                        <a href="#" class="edit-link" onclick="openEditModal(2)">Edit</a><a href="#" class="remove-link" onclick="removeProduct(2)">Remove</a>
                    </td>
                </tr> -->
                        <!-- Add more product rows as needed -->
            </tbody>
        </table>
    </div>

    <!-- Mobile Offcanvas Sidebar -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
        <div class="offcanvas-header bg-warning">
            <h5 class="offcanvas-title" id="sidebarLabel">PRODUCT CATEGORY</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="list-group">
                <a href="/manageProduct" class="list-group-item list-group-item-action">All</a>
                <% categories.forEach(category=> { %>
                    <a href="/manageProduct/<%= category.id %>" class="list-group-item list-group-item-action">
                        <%= category.name %>
                    </a>
                    <% }) %>
            </div>
        </div>
    </div>

    <!-- The Edit Modal -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEditModal()">&times;</span>
            <h2>Edit Product</h2>
            <form id="editForm">
                <div class="form-group">
                    <label for="editProductName">Product Name:</label>
                    <input type="text" id="editProductName" name="productName" required>
                </div>
                <div class="form-group">
                    <label for="editDescription">Description:</label>
                    <textarea id="editDescription" name="description" rows="4" required></textarea>
                </div>
                <div class="form-group">
                    <label for="editPrice">Price: <span class="required">*</span></label>
                    <input type="number" id="editPrice" name="price" step="0.01" min="0.01" required>
                </div>
                <div class="form-group">
                    <label for="editRatio">Ratio:</label>
                    <div class="ratio-inputs">
                        <input type="number" id="number_x" name="number_x" min="1" value="1">
                        <span>:</span>
                        <input type="number" id="number_y" name="number_y" min="1" value="1">
                    </div>
                    <!-- <input type="hidden" id="editSize" name="size">
                    <select id="editSize" name="size">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                        <option value="etc">Etc.</option>
                    </select> -->
                </div>
                <div class="form-group">
                    <label class="mb-2">Categories: <span class="required">*</span></label>
                    <div class="category-checkbox-container border rounded p-3 needs-validation"
                        style="background-color: #f8f9fa; max-height: 250px; overflow-y: auto;">
                        <% categories.forEach(function(category) { %>
                            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                <label for="edit-category-<%= category.id %>" class="me-2 mb-0">
                                    <%= category.name %>
                                </label>
                                <div class="square-checkbox">
                                    <input class="form-check-input" type="checkbox" name="category[]"
                                        value="<%= category.id %>" id="edit-category-<%= category.id %>">
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <div class="invalid-feedback d-block" id="edit-category-feedback" style="display: none !important;">
                        Please select at least one category
                    </div>
                </div>
                <div class="form-group">
                    <label for="editAmount">Amount:</label>
                    <input type="number" id="editAmount" name="amount" step="1" required>
                </div>
                <div class="form-group">
                    <label for="editImage">Upload Image:</label>
                    <input type="file" id="editImage" name="image" accept="image/*">
                </div>
                <button type="submit">Save Changes</button>
            </form>
        </div>
    </div>

    <!-- The Add Modal -->
    <div id="addModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeAddModal()">&times;</span>
            <h2>Add Product</h2>
            <form id="addForm" action="/manageProduct/addProduct" method="post">
                <div class="form-group">
                    <label for="addProductName">Product Name:</label>
                    <input type="text" id="addProductName" name="productName" required>
                </div>
                <div class="form-group">
                    <label for="addDescription">Description:</label>
                    <textarea id="addDescription" name="description" rows="4" required></textarea>
                </div>
                <div class="form-group">
                    <label for="addPrice">Price: <span class="required">*</span></label>
                    <input type="number" id="addPrice" name="price" step="0.01" min="0.01" required>
                </div>
                <div class="form-group">
                    <label for="editRatio">Ratio:</label>
                    <div class="ratio-inputs">
                        <input type="number" id="number_x" name="number_x" min="1" value="1">
                        <span>:</span>
                        <input type="number" id="number_y" name="number_y" min="1" value="1">
                    </div>
                    <!-- <label for="addSize">Size:</label>
                    <select id="addSize" name="size">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                        <option value="etc">Etc.</option>
                    </select> -->
                </div>
                <div class="form-group">
                    <label class="mb-2">Categories: <span class="required">*</span></label>
                    <div class="category-checkbox-container border rounded p-3 needs-validation"
                        style="background-color: #f8f9fa; max-height: 250px; overflow-y: auto;">
                        <% categories.forEach(function(category) { %>
                            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                <label for="add-category-<%= category.id %>" class="me-2 mb-0">
                                    <%= category.name %>
                                </label>
                                <div class="square-checkbox">
                                    <input class="form-check-input" type="checkbox" name="category[]"
                                        value="<%= category.id %>" id="add-category-<%= category.id %>">
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <div class="invalid-feedback d-block" id="add-category-feedback" style="display: none !important;">
                        Please select at least one category
                    </div>
                </div>
                <div class="form-group">
                    <label for="addAmount">Amount:</label>
                    <input type="number" id="addAmount" name="amount" required>
                </div>
                <div class="form-group">
                    <label for="addImage">Upload Image:</label>
                    <input type="file" id="addImage" name="image" accept="image/jpeg,image/jpg,image/png,image/webp">
                </div>
                <button type="submit">Add Product</button>
            </form>
        </div>
    </div>
</body>

</html>