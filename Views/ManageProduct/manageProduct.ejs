<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Product</title>
    <!-- Update to Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="/Views/manageProduct/manageProduct.css">
    <script src="/Views/ManageProduct/manageProduct.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <%- include("../Template/navbar.ejs") %>
</head>

<body>
    <div class="floating-icon">
        <i class="fa-solid fa-plus" id="p-icon" onclick="openAddModal()"></i>
        <i class="fa-solid fa-filter" id="f-icon" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar"></i>
    </div>

    <div class="product-container">
        <h2>Manage Product</h2>
        <div class="add-product-link">
            <div class="mb-3" id="cat-button">
                <button class="btn btn-warning px-4 py-2 fs-5 custom-button" type="button" data-bs-toggle="offcanvas"
                    data-bs-target="#sidebar" aria-controls="sidebar">
                    <i class="fa-solid fa-filter"></i></i> Filter
                </button>
            </div>
            <a onclick="openAddModal()" class="custom-button">Add Product</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th style="text-align: center;"><i class="fas fa-hashtag me-2"></i>ID</th>
                    <th><i class="fas fa-box me-2"></i>Product Name</th>
                    <th><i class="fas fa-align-left me-2"></i>Description</th>
                    <th><i class="fas fa-tag me-2"></i>Price</th>
                    <th><i class="fas fa-expand me-2"></i>Ratio</th>
                    <th><i class="fas fa-cubes me-2"></i>Current Amount</th>
                    <th><i class="fas fa-image me-2"></i>Image</th>
                    <th><i class="fas fa-tags me-2"></i>Category</th>
                    <th style="text-align: center;"><i class="fas fa-cog me-2"></i>Actions</th>
                </tr>
            </thead>
            <tbody>
                <!-- Example product rows -->
                <% data.forEach((item)=>{ %>
                    <tr>
                        <td style="text-align: center;">
                            <%= item.id %>
                        </td>
                        <td>
                            <%= item.name %>
                        </td>
                        <td>
                            <%= item.description %>
                        </td>
                        <td>
                            <%= item.price %>
                        </td>
                        <td>
                            <%= item.size %>
                        </td>
                        <td>
                            <%= item.amount %>
                        </td>
                        <td><img src="/Asset/Product/<%=item.image%>" alt="Product ID:<%= item.id %>" width="50"></td>
                        <td>
                            <% if (item.categories && item.categories.length > 0) { %>
                                <ul class="category-list">
                                    <% item.categories.forEach((cat) => { %>
                                        <li><%= cat.name %></li><br>
                                    <% }); %>
                                </ul>
                            <% } else { %>
                                <span class="no-category">No categories</span>
                            <% } %>
                        </td>
                        <td style="text-align: center;">
                            <a class="edit-link" onclick="event.preventDefault(); openEditModal('<%= item.id %>')">
                                <i class="fas fa-edit me-2"></i>Edit
                            </a>
                            <span style="border: #33322B solid 1px; height: 2rem; opacity: 0.3; margin-left:5px; margin-right:8px"></span>
                            <a class="remove-link" onclick="event.preventDefault(); removeProduct('<%= item.id %>')">
                                <i class="fas fa-trash-alt me-2"></i>Remove
                            </a>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Mobile Offcanvas Sidebar -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
        <div class="offcanvas-header bg-warning">
            <h5 class="offcanvas-title" id="sidebarLabel">PRODUCT CATEGORY</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="list-group">
                <a href="/manageProduct" class="list-group-item list-group-item-action">All</a>
                <% categories.forEach(category=> { %>
                    <a href="/manageProduct/<%= category.id %>" class="list-group-item list-group-item-action">
                        <%= category.name %>
                    </a>
                    <% }) %>
            </div>
        </div>
    </div>

    <!-- The Edit Modal -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeEditModal()"><i class="fas fa-times"></i></span>
            <h2>Edit Product</h2>
            <form id="editForm">
                <div class="form-group">
                    <label for="editProductName"><i class="fas fa-tag me-2"></i>Product Name:</label>
                    <input type="text" id="editProductName" name="productName" required>
                    <div class="warning-message mt-2">
                        <i class="fas fa-exclamation-triangle text-warning"></i> 
                        <span class="text-muted"><small>Note: You cannot change both the product name and image simultaneously.</small></span>
                    </div>
                </div>
                <div class="form-group">
                    <label for="editDescription"><i class="fas fa-align-left me-2"></i>Description:</label>
                    <textarea id="editDescription" name="description" rows="4" required></textarea>
                </div>
                <div class="form-group">
                    <label for="editPrice"><i class="fas fa-dollar-sign me-2"></i>Price: <span class="required">*</span></label>
                    <input type="number" id="editPrice" name="price" step="0.01" min="0.01" required>
                </div>
                <div class="form-group">
                    <label for="editRatio"><i class="fas fa-expand-alt me-2"></i>Ratio:</label>
                    <div class="ratio-inputs">
                        <input type="number" id="number_x" name="number_x" min="1" value="1">
                        <span>:</span>
                        <input type="number" id="number_y" name="number_y" min="1" value="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="mb-2"><i class="fas fa-tags me-2"></i>Categories: <span class="required">*</span></label>
                    <div class="category-checkbox-container border rounded p-3 needs-validation"
                        style="background-color: #f8f9fa; max-height: 250px; overflow-y: auto;">
                        <% categories.forEach(function(category) { %>
                            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                <label for="edit-category-<%= category.id %>" class="me-2 mb-0">
                                    <%= category.name %>
                                </label>
                                <div class="square-checkbox">
                                    <input class="form-check-input" type="checkbox" name="category[]"
                                        value="<%= category.id %>" id="edit-category-<%= category.id %>">
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <div class="invalid-feedback d-block" id="edit-category-feedback" style="display: none !important;">
                        Please select at least one category
                    </div>
                </div>
                <div class="form-group">
                    <label for="editAmount"><i class="fas fa-boxes me-2"></i>Amount:</label>
                    <input type="number" id="editAmount" name="amount" step="1" required>
                </div>
                <div class="form-group">
                    <label for="editImage"><i class="fas fa-image me-2"></i>Upload Image:</label>
                    <div class="image-upload-container">
                        <input type="file" id="editImage" name="image" accept="image/*" onchange="previewImage(this, 'editImagePreview')">
                        <div class="image-preview-container">
                            <img id="editImagePreview" src="/Asset/placeholder-image.webp" alt="Preview" class="image-preview">
                            <div class="no-image-text">No image selected</div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="submit-btn"><i class="fas fa-save me-2"></i>Save Changes</button>
            </form>
        </div>
    </div>

    <!-- The Add Modal -->
    <div id="addModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeAddModal()"><i class="fas fa-times"></i></span>
            <h2>Add Product</h2>
            <form id="addForm" action="/manageProduct/addProduct" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="addProductName"><i class="fas fa-tag me-2"></i>Product Name:</label>
                    <input type="text" id="addProductName" name="productName" required>
                </div>
                <div class="form-group">
                    <label for="addDescription"><i class="fas fa-align-left me-2"></i>Description:</label>
                    <textarea id="addDescription" name="description" rows="4" required></textarea>
                </div>
                <div class="form-group">
                    <label for="addPrice"><i class="fas fa-dollar-sign me-2"></i>Price: <span class="required">*</span></label>
                    <input type="number" id="addPrice" name="price" step="0.01" min="0.01" required>
                </div>
                <div class="form-group">
                    <label for="editRatio"><i class="fas fa-expand-alt me-2"></i>Ratio:</label>
                    <div class="ratio-inputs">
                        <input type="number" id="number_x" name="number_x" min="1" value="1">
                        <span>:</span>
                        <input type="number" id="number_y" name="number_y" min="1" value="1">
                    </div>
                </div>
                <div class="form-group">
                    <label class="mb-2"><i class="fas fa-tags me-2"></i>Categories: <span class="required">*</span></label>
                    <div class="category-checkbox-container border rounded p-3 needs-validation"
                        style="background-color: #f8f9fa; max-height: 250px; overflow-y: auto;">
                        <% categories.forEach(function(category) { %>
                            <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                                <label for="add-category-<%= category.id %>" class="me-2 mb-0">
                                    <%= category.name %>
                                </label>
                                <div class="square-checkbox">
                                    <input class="form-check-input" type="checkbox" name="category[]"
                                        value="<%= category.id %>" id="add-category-<%= category.id %>">
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <div class="invalid-feedback d-block" id="add-category-feedback" style="display: none !important;">
                        Please select at least one category
                    </div>
                </div>
                <div class="form-group">
                    <label for="addAmount"><i class="fas fa-boxes me-2"></i>Amount:</label>
                    <input type="number" id="addAmount" name="amount" required>
                </div>
                <div class="form-group">
                    <label for="addImage"><i class="fas fa-image me-2"></i>Upload Image:</label>
                    <div class="image-upload-container">
                        <input type="file" id="addImage" name="image" accept="image/jpeg, image/jpg, image/png, image/webp, image/gif, image/jfif" onchange="previewImage(this, 'addImagePreview')">
                        <div class="image-preview-container">
                            <img id="addImagePreview" src="/Asset/placeholder-image.webp" alt="Preview" class="image-preview">
                            <div class="no-image-text">No image selected</div>
                        </div>
                    </div>
                </div>
                <button type="submit" class="submit-btn"><i class="fas fa-plus me-2"></i>Add Product</button>
            </form>
        </div>
    </div>
</body>

</html>