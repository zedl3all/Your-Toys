<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f5f5f5;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        
        .payment-container {
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            width: 100%;
            max-width: 500px;
            padding: 30px;
            text-align: center;
        }
        
        .payment-title {
            color: #333;
            margin-top: 0;
            margin-bottom: 20px;
            font-size: 24px;
        }
        
        .form-group {
            margin-bottom: 20px;
            text-align: left;
        }
        
        label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-weight: bold;
        }
        
        input[type="number"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
        }
        
        .generate-btn {
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        
        .generate-btn:hover {
            background-color: #2980b9;
        }
        
        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            width: 90%;
            max-width: 800px; /* Increased width to accommodate side-by-side layout */
            padding: 30px;
            text-align: center;
            position: relative;
            animation: modalFadeIn 0.3s;
        }
        
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .close-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            background: none;
            border: none;
            font-size: 24px;
            color: #aaa;
            cursor: pointer;
            transition: color 0.3s;
        }
        
        .close-btn:hover {
            color: #555;
        }
        
        .qr-container {
            background-color: #f8f8f8;
            border-radius: 10px;
            padding: 20px;
            margin: 20px 0;
            display: flex;
            justify-content: center;
        }
        
        .qr-container img, .qr-container svg {
            max-width: 100%;
            height: auto;
        }
        
        .qr-info {
            margin-top: 20px;
            color: #555;
        }
        
        .promptpay-id {
            font-weight: bold;
            color: #3498db;
            font-size: 18px;
            margin: 10px 0;
        }
        
        .amount-display {
            background-color: #ebf5fb;
            color: #3498db;
            border-radius: 8px;
            padding: 10px 15px;
            font-weight: bold;
            display: inline-block;
            margin: 10px 0;
            font-size: 20px;
        }

        .upload-section {
            margin-top: 30px;
            border-top: 1px solid #eee;
            padding-top: 20px;
        }
        
        .file-input-wrapper {
            margin: 20px 0;
        }
        
        .file-input {
            width: 0.1px;
            height: 0.1px;
            opacity: 0;
            overflow: hidden;
            position: absolute;
            z-index: -1;
        }
        
        .file-label {
            background-color: #e7f4fd;
            color: #3498db;
            border: 2px dashed #3498db;
            border-radius: 5px;
            padding: 12px 24px;
            display: block;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
        }
        
        .file-label:hover {
            background-color: #d0e9fb;
        }
        
        .upload-btn {
            background-color: #27ae60;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
            width: 100%;
        }
        
        .upload-btn:disabled {
            background-color: #95a5a6;
            cursor: not-allowed;
        }
        
        .upload-btn:hover:not(:disabled) {
            background-color: #2ecc71;
        }
        
        .upload-status {
            margin-top: 15px;
            font-weight: bold;
        }
        
        .status-success {
            color: #27ae60;
        }
        
        .status-error {
            color: #e74c3c;
        }
        
        .preview-container {
            margin: 15px 0;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            max-height: 200px;
        }
        
        .preview-container img {
            width: 100%;
            height: auto;
            object-fit: contain;
        }

        .payment-flex-container {
            display: flex;
            flex-direction: row;
            gap: 20px;
            margin-top: 20px;
        }
        
        .payment-left-section {
            flex: 1;
        }
        
        .payment-right-section {
            flex: 1;
            border-left: 1px solid #eee;
            padding-left: 20px;
            text-align: left;
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .payment-flex-container {
                flex-direction: column;
                max-height: 70dvh; /* Limit height on mobile */
                overflow-y: auto; /* Add vertical scrollbar when needed */
                padding-right: 5px; /* Add some space for the scrollbar */
            }
            
            .payment-right-section {
                border-left: none;
                border-top: 1px solid #eee;
                padding-left: 0;
                padding-top: 20px;
                margin-top: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="payment-container">
        <h1 class="payment-title">Generate Payment QR Code</h1>
        
        <div class="form-group">
            <label for="amount">Amount (THB):</label>
            <input type="number" id="amount" step="0.01" min="0" value="0.22">
        </div>
        
        <button class="generate-btn" onclick="generateQR()">Generate QR Code</button>
    </div>
    
    <!-- QR Code Modal -->
    <div id="qrModal" class="modal">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal()">&times;</button>
            <h2>PromptPay QR Payment</h2>
            
            <div class="payment-flex-container">
                <!-- Left side - QR code -->
                <div class="payment-left-section">
                    <div id="qrContainer" class="qr-container">
                        <!-- QR code will be inserted here -->
                        <div class="loading">Generating QR code...</div>
                    </div>
                    
                    <div class="qr-info">
                        <p>Scan this QR code with any banking app that supports PromptPay</p>
                        <p class="promptpay-id" id="promptpayDisplay"></p>
                        <div class="amount-display" id="amountDisplay"></div>
                    </div>
                </div>
                
                <!-- Right side - Upload section -->
                <div id="uploadSection" class="payment-right-section" style="display: none;">
                    <h3>Payment Completed?</h3>
                    <p>Please upload a screenshot of your payment confirmation</p>
                    
                    <div id="previewContainer" class="preview-container" style="display: none;">
                        <img id="imagePreview" src="#" alt="Payment Proof Preview">
                    </div>
                    
                    <div class="file-input-wrapper">
                        <input type="file" id="paymentProof" accept="image/*" class="file-input">
                        <label for="paymentProof" class="file-label">Select Screenshot</label>
                    </div>
                    
                    <button id="uploadBtn" class="upload-btn" disabled>Upload Payment Proof</button>
                    <div id="uploadStatus" class="upload-status"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Show the modal
        function showModal() {
            document.getElementById('qrModal').classList.add('active');
        }
        
        // Hide the modal
        function closeModal() {
            document.getElementById('qrModal').classList.remove('active');
        }
        
        // Close modal if clicking outside content
        document.getElementById('qrModal').addEventListener('click', function(event) {
            if (event.target === this) {
                closeModal();
            }
        });
        
        // Generate QR code and show in modal
        function generateQR() {
            const amount = document.getElementById('amount').value;
            const promptpay = '0875513773'; // This value could be fetched from server
            
            // Show modal with loading state
            showModal();
            document.getElementById('qrContainer').innerHTML = '<div class="loading">Generating QR code...</div>';
            
            // Format display values
            document.getElementById('promptpayDisplay').textContent = 'ID: ' + 
                promptpay.replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3');
            document.getElementById('amountDisplay').textContent = '฿ ' + parseFloat(amount).toFixed(2);
            
            // Fetch the QR code using POST
            fetch('/getqr', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    amount: amount,
                    format: 'json'
                })
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('qrContainer').innerHTML = data.qrCode;
                // Show upload section after QR code is displayed
                document.getElementById('uploadSection').style.display = 'block';
            })
            .catch(error => {
                document.getElementById('qrContainer').innerHTML = 
                    '<p class="error">Error generating QR code. Please try again.</p>';
                console.error('Error:', error);
            });
        }
        
        // Handle file selection
        document.getElementById('paymentProof').addEventListener('change', function(event) {
            const file = event.target.files[0];
            const uploadBtn = document.getElementById('uploadBtn');
            
            if (file) {
                uploadBtn.removeAttribute('disabled');
                
                // Preview the selected image
                const previewContainer = document.getElementById('previewContainer');
                const imagePreview = document.getElementById('imagePreview');
                const reader = new FileReader();
                
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    previewContainer.style.display = 'block';
                };
                
                reader.readAsDataURL(file);
            } else {
                uploadBtn.setAttribute('disabled', 'disabled');
                document.getElementById('previewContainer').style.display = 'none';
            }
        });
        
        // Handle file upload
        document.getElementById('uploadBtn').addEventListener('click', function() {
            const fileInput = document.getElementById('paymentProof');
            const file = fileInput.files[0];
            const statusDiv = document.getElementById('uploadStatus');
            
            if (!file) {
                statusDiv.textContent = 'Please select a file first';
                statusDiv.className = 'upload-status status-error';
                return;
            }
            
            // Create FormData object
            const formData = new FormData();
            formData.append('paymentProof', file);
            formData.append('amount', document.getElementById('amount').value);
            formData.append('promptpay', '0875513773');
            
            // Disable button and show loading state
            this.disabled = true;
            this.textContent = 'Uploading...';
            statusDiv.textContent = 'Uploading your payment proof...';
            statusDiv.className = 'upload-status';
            
            // Send the file to server
            fetch('/upload-payment-proof', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    statusDiv.textContent = 'Payment proof uploaded successfully!';
                    statusDiv.className = 'upload-status status-success';
                    this.textContent = 'Uploaded ✓';
                } else {
                    throw new Error(data.message || 'Upload failed');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                statusDiv.textContent = 'Error uploading payment proof: ' + error.message;
                statusDiv.className = 'upload-status status-error';
                this.disabled = false;
                this.textContent = 'Try Again';
            });
        });
    </script>
</body>
</html>